{
  "name": "nexus-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, project-aware desktop engineering agent",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc --watch",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js && electron .",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/code-editing/diff.test.ts src/code-editing/patch.test.ts src/tasks/task-service.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
